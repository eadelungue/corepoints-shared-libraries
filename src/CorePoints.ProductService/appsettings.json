{
  "ConnectionStrings": {
    "ProductDb": "Host=localhost;Port=5432;Database=product_service;Username=product_user;Password=product_pass",
    "FeatureTogglesDb": "Host=localhost;Port=5432;Database=product_service;Username=product_user;Password=product_pass"
  },
  "Caching": {
    "RedisConnectionString": "localhost:6379",
    "DefaultTtlSeconds": 300,
    "ProductDataTtlSeconds": 1800,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerBreakDurationSeconds": 30,
    "SyncTimeoutMs": 1000
  },
  "Services": {
    "Ledger": {
      "BaseUrl": "http://ledger-core.corepoints.local:8080"
    }
  },
  "Resilience": {
    "Ledger": {
      "MaxRetryAttempts": 3,
      "MedianFirstRetryDelay": "00:00:01",
      "AttemptTimeout": "00:00:05",
      "BulkheadMaxConcurrency": 25,
      "BulkheadQueueLimit": 10,
      "CircuitBreakerThreshold": 10,
      "CircuitBreakerSamplingWindow": "00:00:30",
      "CircuitBreakerDuration": "00:00:30"
    }
  },
  "FeatureToggles": {
    "ConnectionString": "Host=localhost;Port=5432;Database=product_service;Username=product_user;Password=product_pass",
    "CacheTtl": "00:01:00"
  },
  "Jwt": {
    "Authority": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_example",
    "Audience": "product-service-client-id"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
